generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum UserRole {
  admin
  manager
  operator // daily ops: run/pause campaigns + live reports, no content editing
  client

  @@map("user_role")
}

enum SubscriberStatus {
  active
  unsubscribed
  expired

  @@map("subscriber_status")
}

enum DeviceType {
  mobile
  desktop
  tablet

  @@map("device_type")
}

enum CampaignStatus {
  draft
  scheduled
  sending
  paused
  sent
  cancelled
  failed

  @@map("campaign_status")
}

enum SendStatus {
  queued
  sent
  failed
  expired

  @@map("send_status")
}

// ---------- models ----------

model Tenant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  brandName         String?   @map("brand_name")
  brandLogoUrl      String?   @map("brand_logo_url")
  brandPrimaryColor String?   @map("brand_primary_color")
  customDomain      String?   @map("custom_domain")
  plan              String    @default("internal")
  billingRates      Json?     @map("billing_rates") // {per_send, per_click, currency}
  integrations      Json?     // {google_ads: {developerToken, clientId, clientSecret, refreshToken, customerId, loginCustomerId, apiVersion}}
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz()

  users       User[]
  properties  Property[]
  subscribers Subscriber[]
  segments    Segment[]
  campaigns   Campaign[]
  sends       Send[]
  auditLogs   AuditLog[]
  automations Automation[]

  @@map("tenants")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  propertyIds  String[]  @map("property_ids") @db.Uuid
  // optional per-page access whitelist (empty = every page the role allows).
  // Lets an admin restrict a user to specific sections beyond the coarse role.
  allowedPages String[]  @default([]) @map("allowed_pages")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model Property {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  propertyKey         String    @unique @map("property_key")
  domains             String[]
  iconUrl             String?   @map("icon_url")
  promptConfig        Json      @default("{}") @map("prompt_config")
  vapidPublic         String?   @map("vapid_public")
  vapidPrivate        String?   @map("vapid_private")
  frequencyCapPerDay  Int       @default(2) @map("frequency_cap_per_day")
  frequencyCapPerWeek Int       @default(8) @map("frequency_cap_per_week")
  autoAssign          Json?     @map("auto_assign") // {status, rules:[{segmentId,weight}], counts}
  monthlySendQuota    BigInt?   @map("monthly_send_quota")
  status              String    @default("active")
  apiKeyHash          String?   @map("api_key_hash")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz()
  verification        Json?
  adsCheck            Json?     @map("ads_check") // last Google-norms compliance check {verdict, checks:[...], at}
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  subscribers Subscriber[]
  segments    Segment[]
  campaigns   Campaign[]
  pages       PagePath[]
  automations Automation[]
  conversions Conversion[]

  @@index([tenantId])
  @@map("properties")
}

// pages discovered by the snippet's pageview beacon
model PagePath {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  path        String
  views       Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz()

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, path])
  @@map("pages")
}

model Subscriber {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  propertyId     String           @map("property_id") @db.Uuid
  endpoint       String
  p256dh         String
  auth           String
  status         SubscriberStatus @default(active)
  utmSource      String?          @map("utm_source")
  utmMedium      String?          @map("utm_medium")
  utmCampaign    String?          @map("utm_campaign")
  utmContent     String?          @map("utm_content")
  utmTerm        String?          @map("utm_term")
  landingUrl     String?          @map("landing_url")
  referrer       String?
  country        String?          @db.Char(2)
  region         String?
  city           String?
  device         DeviceType?
  browser        String?
  os             String?
  language       String?
  timezone       String?
  pushesReceived Int              @default(0) @map("pushes_received")
  pushesClicked  Int              @default(0) @map("pushes_clicked")
  lastPushAt     DateTime?        @map("last_push_at") @db.Timestamptz()
  lastClickAt    DateTime?        @map("last_click_at") @db.Timestamptz()
  subscribedAt   DateTime         @default(now()) @map("subscribed_at") @db.Timestamptz()
  unsubscribedAt DateTime?        @map("unsubscribed_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime?        @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  property       Property        @relation(fields: [propertyId], references: [id])
  sends          Send[]
  automationJobs AutomationJob[]
  conversions    Conversion[]

  @@unique([propertyId, endpoint])
  @@index([propertyId, status])
  @@index([propertyId, utmCampaign])
  @@index([propertyId, subscribedAt])
  @@index([propertyId, country])
  @@map("subscribers")
}

model Segment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  name        String
  criteria    Json
  isDynamic   Boolean   @default(true) @map("is_dynamic")
  cachedCount Int?      @map("cached_count")
  cachedAt    DateTime? @map("cached_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  property  Property   @relation(fields: [propertyId], references: [id])
  campaigns Campaign[]

  @@index([tenantId])
  @@index([propertyId]) // dashboard lists segments per property
  @@map("segments")
}

model Campaign {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  propertyId         String         @map("property_id") @db.Uuid
  name               String
  title              String
  body               String
  iconUrl            String?        @map("icon_url")
  imageUrl           String?        @map("image_url")
  clickUrl           String         @map("click_url")
  // call-first: when set, tapping the notification body dials one of these
  // numbers (per-lead routing), overriding clickUrl
  callNumbers        String[]       @default([]) @map("call_numbers")
  callStrategy       String         @default("round_robin") @map("call_strategy")
  // optional label shown in previews as the notification source; real pushes
  // always display the property's push origin (browser-enforced)
  sourceDomain       String?        @map("source_domain")
  actions            Json?
  segmentId          String?        @map("segment_id") @db.Uuid
  segmentIds         String[]       @default([]) @map("segment_ids") @db.Uuid
  mixStrategy        String         @default("mixed") @map("mix_strategy") // mixed | sequential | zone
  targetAll          Boolean        @default(false) @map("target_all") // explicit: blast every active lead
  status             CampaignStatus @default(draft)
  pacingPerMinute    Int?           @map("pacing_per_minute")
  scheduleAt         DateTime?      @map("schedule_at") @db.Timestamptz()
  recurrence         Json?
  abConfig           Json?          @map("ab_config")
  totalTargeted      Int?           @map("total_targeted")
  totalSent          Int            @default(0) @map("total_sent")
  totalDelivered     Int            @default(0) @map("total_delivered")
  totalClicked       Int            @default(0) @map("total_clicked")
  totalFailed        Int            @default(0) @map("total_failed")
  totalExpiredPruned Int            @default(0) @map("total_expired_pruned")
  startedAt          DateTime?      @map("started_at") @db.Timestamptz()
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz()
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime?      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  segment  Segment? @relation(fields: [segmentId], references: [id])
  sends    Send[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model Send {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  campaignId   String?    @map("campaign_id") @db.Uuid
  automationId String?    @map("automation_id") @db.Uuid
  subscriberId String     @map("subscriber_id") @db.Uuid
  variant      String? // A/B test arm
  status       SendStatus @default(queued)
  clicked      Boolean    @default(false)
  errorCode    String?    @map("error_code")
  sentAt       DateTime?  @map("sent_at") @db.Timestamptz()
  clickedAt    DateTime?  @map("clicked_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  automation Automation? @relation(fields: [automationId], references: [id])
  subscriber Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([subscriberId]) // GDPR cascade delete + segment activity join
  @@index([tenantId, createdAt]) // monthly quota / billing counts
  @@index([campaignId, createdAt]) // CDR paging + old-send prune
  @@map("sends")
}

// drip sequences triggered by events (v1: on subscribe)
model Automation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  name       String
  trigger    String    @default("subscribe")
  status     String    @default("active") // active | paused
  steps      Json // [{delay_minutes, title, body, click_url, icon_url}]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  jobs     AutomationJob[]
  sends    Send[]

  @@index([propertyId, status])
  @@map("automations")
}

model AutomationJob {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  automationId String   @map("automation_id") @db.Uuid
  subscriberId String   @map("subscriber_id") @db.Uuid
  stepIndex    Int      @map("step_index")
  dueAt        DateTime @map("due_at") @db.Timestamptz()
  status       String   @default("queued") // queued | sent | failed | cancelled
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([subscriberId]) // cascade delete on GDPR erase / unsubscribe cancel
  @@map("automation_jobs")
}

// revenue attribution: conversions reported by pixel or webhook
model Conversion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  subscriberId String?  @map("subscriber_id") @db.Uuid
  sendId       String?  @map("send_id") @db.Uuid
  campaignId   String?  @map("campaign_id") @db.Uuid
  orderId      String?  @map("order_id")
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("INR")
  source       String   @default("pixel") // pixel | webhook
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([campaignId])
  @@index([subscriberId]) // SetNull on GDPR erase avoids a seq scan
  @@map("conversions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_log")
}
