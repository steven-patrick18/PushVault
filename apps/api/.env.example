# Owner connection — used by Prisma migrations, seed, and system-level lookups (login)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pushvault

# Restricted app role — RLS enforced; used for all tenant-scoped queries
APP_DATABASE_URL=postgres://pv_app:pv_app_dev_password@localhost:5433/pushvault

JWT_SECRET=change-me-in-production
PORT=3000
APP_BASE_URL=http://localhost:3000
CDN_BASE_URL=http://localhost:3000/cdn

# Phase 2+ (M2 onward)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@pushvault.example
# REDIS_URL=redis://localhost:6379
# GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
