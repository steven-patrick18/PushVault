# ======= PushVault production config =======
# Copy to deploy/.env and fill in — NEVER commit the filled file.

# The domain the whole platform lives on (dashboard + API + snippet CDN).
# Point an A record for it at this server's IP BEFORE first start.
PUSH_DOMAIN=push.amanotelecom.com
ACME_EMAIL=you@example.com

# Strong random secrets — generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG
PV_APP_PASSWORD=CHANGE_ME_STRONG_2
JWT_SECRET=CHANGE_ME_STRONG_3

# Web push identity — generate ONCE on the server (see DEPLOY.md §4):
#   docker run --rm node:22-bookworm-slim npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@amanotelecom.com

# First admin account (created by the seed step)
ADMIN_EMAIL=admin@amanotelecom.com
ADMIN_PASSWORD=CHANGE_ME_LOGIN

# Optional: MaxMind GeoLite2 for geo capture (DEPLOY.md §7)
GEOIP_DB_PATH=

# Optional: live Stripe checkout
STRIPE_SECRET_KEY=
