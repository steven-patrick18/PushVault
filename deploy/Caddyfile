{
	email {$ACME_EMAIL}
	# hosted opt-in subdomains get certs on demand, but only if the API confirms
	# the host is a registered property domain (anti-abuse gate)
	on_demand_tls {
		ask http://api:3000/api/v1/public/tls-check
	}
}

# the dashboard + API + CDN
{$PUSH_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
}

# any other host pointed here (property opt-in subdomains) — TLS issued on
# demand for approved domains; the API serves the branded page + /pv-sw.js
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy api:3000
}
